{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/quiz.schema.json",
  "title": "Quiz",
  "description": "Bieu dien mot de trac nghiem. id va created_at do server tao.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "time_limit_minutes", "status", "created_at"],
  "properties": {
    "id": {"type": "integer", "minimum": 1, "readOnly": true},
    "title": {"type": "string", "minLength": 5, "maxLength": 150},
    "description": {"type": "string", "maxLength": 1000, "default": ""},
    "time_limit_minutes": {"type": "integer", "minimum": 1, "maximum": 180},
    "status": {"type": "string", "enum": ["draft", "published", "closed"], "default": "draft"},
    "created_at": {"type": "string", "format": "date-time", "readOnly": true}
  },
  "examples": [{
    "id": 1,
    "title": "Kiem tra kien thuc REST API",
    "description": "10 cau hoi co ban ve HTTP va API",
    "time_limit_minutes": 15,
    "status": "published",
    "created_at": "2026-10-19T09:00:00Z"
  }]
}
