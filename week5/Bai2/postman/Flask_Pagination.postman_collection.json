    {
      "name": "02 - Offset",
      "item": [
        {
          "name": "Offset: first page, limit=2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r=pm.response.json();",
                  "const expected=['C','A'].map(k => Number(pm.collectionVariables.get('book_'+k+'_id')));",
                  "pm.expect(r.data.map(x => x.id)).to.eql(expected);",
                  "pm.expect(r.page.next).to.eql(2);",
                  "pm.expect(r.page.total).to.eql(4);",
                  "pm.expect(r.more).to.eql(true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?strategy=offset&genre={{fiction_genre}}&sort=price%2C-title&limit=2&offset=0"
            }
          },
          "response": []
        },
        {
          "name": "Offset: second page, offset=2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r=pm.response.json();",
                  "const expected=['B','D'].map(k => Number(pm.collectionVariables.get('book_'+k+'_id')));",
                  "pm.expect(r.data.map(x => x.id)).to.eql(expected);",
                  "pm.expect(r.page.next).to.eql(null);",
                  "pm.expect(r.more).to.eql(false);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?strategy=offset&genre={{fiction_genre}}&sort=price%2C-title&limit=2&offset=2"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Cursor",
      "item": [
        {
          "name": "Cursor: first page (save cursor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r=pm.response.json();",
                  "const expected=['C','A'].map(k => Number(pm.collectionVariables.get('book_'+k+'_id')));",
                  "pm.expect(r.data.map(x => x.id)).to.eql(expected);",
                  "pm.expect(r.more).to.eql(true);",
                  "pm.expect(r.page.next).to.be.a('string');",
                  "pm.collectionVariables.set('next_cursor', r.page.next);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?strategy=cursor&genre={{fiction_genre}}&sort=price%2C-title&limit=2"
            }
          },
          "response": []
        },
        {
          "name": "Cursor: second page using saved token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r=pm.response.json();",
                  "const expected=['B','D'].map(k => Number(pm.collectionVariables.get('book_'+k+'_id')));",
                  "pm.expect(r.data.map(x => x.id)).to.eql(expected);",
                  "pm.expect(r.more).to.eql(false);",
                  "pm.expect(r.page.next).to.eql(null);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/books?strategy=cursor&genre={{fiction_genre}}&sort=price%2C-title&limit=2&cursor={{next_cursor}}"
            }
          },
          "response": []
        }
      ]
    },
