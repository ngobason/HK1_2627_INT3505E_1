{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "type": "object",
  "additionalProperties": false,
  "required": ["email", "display_name"],
  "properties": {
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 150 }
  }
}
