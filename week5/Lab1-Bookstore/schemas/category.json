{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Category",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
